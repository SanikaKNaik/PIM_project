# ==============================================================================
# Stitch PIM Backend - Environment Configuration
# ==============================================================================

# Server Network Port
PORT=5000
NODE_ENV=development

# Security & JWT Token Signing
JWT_SECRET="stitch_pim_super_secret_jwt_key_2026_eval"
JWT_EXPIRES_IN="7d"

# MySQL Database Connection (MySQL 8.0+)
DB_HOST="localhost"
DB_PORT=3306
DB_USER="stitch_admin"
DB_PASSWORD="your_mysql_password"
DB_NAME="stitch_pim"
DB_CONNECTION_LIMIT=10

# WooCommerce REST API Credentials
# Configure these to connect to your live WordPress/WooCommerce store
WOOCOMMERCE_STORE_URL="https://shop.yourdomain.com"
WOOCOMMERCE_CONSUMER_KEY="ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WOOCOMMERCE_CONSUMER_SECRET="cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
