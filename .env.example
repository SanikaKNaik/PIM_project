# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# API Configuration
PORT=3000
VITE_API_BASE_URL="/api"

# MySQL Database Connection (Optional - falls back to high-performance Unified Store if unset)
DB_HOST="localhost"
DB_PORT=3306
DB_USER="stitch_admin"
DB_PASSWORD="your_mysql_password"
DB_NAME="stitch_pim"

# WooCommerce API Configuration (Can also be set in the UI via WooCommerce Sync Hub)
WOOCOMMERCE_STORE_URL="https://shop.yourdomain.com"
WOOCOMMERCE_CONSUMER_KEY="ck_your_consumer_key"
WOOCOMMERCE_CONSUMER_SECRET="cs_your_consumer_secret"
